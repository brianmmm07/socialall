# Easiest: connect platforms in the app (Accounts in the sidebar). Keys saved
# there go in your macOS Keychain and win over this file.
# This file still works: copy it to .env and fill in the platforms you have.
# Platforms with missing keys are skipped.

# Free: one Apify token (console.apify.com, $5 of usage a month, no card) for X, Instagram, TikTok, LinkedIn.
APIFY_TOKEN=
# APIFY_PLATFORMS=x,instagram,tiktok,linkedin
# APIFY_ACTOR_X=apidojo/twitter-scraper-lite

# Paid: one key for all five platforms (socialcrawl.dev). Platforms with their own keys below use those.
SOCIALCRAWL_API_KEY=
# SOCIALCRAWL_PLATFORMS=x,instagram,xiaohongshu,tiktok,linkedin

# Where the app keeps accounts.json (and credentials.json when there's no keychain).
# SOCIALALL_CONFIG_DIR=~/Library/Application Support/SocialAll
# SOCIALALL_KEYRING=auto   # off: use credentials.json instead of the keychain

# X (Twitter) API v2, plan with search access (Basic or higher)
X_BEARER_TOKEN=
# For "Sign in with X" (OAuth 2.0 app on developer.x.com)
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# For "Sign in with Facebook" (Meta app)
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_GRAPH_VERSION=v21.0

# TikTok Research API (approved research access)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn Posts API (Community Management). Comma separated author URNs to read.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URNS=urn:li:organization:12345
# For "Sign in with LinkedIn"
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_SCOPES=r_organization_social
# LINKEDIN_API_VERSION=202410

# Xiaohongshu: no official API. URL of a bridge service you run (see README).
XHS_BRIDGE_URL=
XHS_BRIDGE_TOKEN=

# Demo data: auto (only when nothing above is set), on, or off
SOCIALALL_DEMO=auto
SOCIALALL_DB=socialall.db

# Favourites: where videos of starred posts are saved, and the size limit per video
SOCIALALL_CACHE_DIR=cache/videos
SOCIALALL_MAX_VIDEO_MB=500

# Performance: seconds to wait for each platform, and how long to reuse a search
SOCIALALL_PLATFORM_TIMEOUT=15
SOCIALALL_SEARCH_TTL=300

# Following accounts through RSSHub (free, no limit). The app's Start button runs it in Docker.
# RSSHUB_URL=http://127.0.0.1:1200
# Login token (the auth_token cookie) of a spare X account, so RSSHub can read X.
# TWITTER_AUTH_TOKEN=
# How often to check followed accounts, in minutes. 0 turns it off.
# SOCIALALL_FEED_MINUTES=15
# Saved topics searched again by themselves each day, one topic at a time (uses Apify allowance). 0 turns it off.
# SOCIALALL_TOPIC_REFRESHES_PER_DAY=1
# How often to read your own signed-in For you feeds (Instagram, TikTok, Xiaohongshu), in hours. 0: only on Read now.
# SOCIALALL_FORYOU_HOURS=2
