# Copy to .env and fill in the platforms you have access to.
# Platforms with missing keys are skipped.

# X (Twitter) API v2, plan with search access (Basic or higher)
X_BEARER_TOKEN=

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# INSTAGRAM_GRAPH_VERSION=v21.0

# TikTok Research API (approved research access)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn Posts API (Community Management). Comma separated author URNs to read.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URNS=urn:li:organization:12345
# LINKEDIN_API_VERSION=202410

# Xiaohongshu: no official API. URL of a bridge service you run (see README).
XHS_BRIDGE_URL=
XHS_BRIDGE_TOKEN=

# Demo data: auto (only when nothing above is set), on, or off
SOCIALALL_DEMO=auto
SOCIALALL_DB=socialall.db

# Favourites: where videos of starred posts are saved, and the size limit per video
SOCIALALL_CACHE_DIR=cache/videos
SOCIALALL_MAX_VIDEO_MB=500

# Performance: seconds to wait for each platform, and how long to reuse a search
SOCIALALL_PLATFORM_TIMEOUT=15
SOCIALALL_SEARCH_TTL=300
